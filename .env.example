# Use an OpenAI-compatible Chat Completions endpoint. Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RAG_EVAL_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5.4-mini
OPENAI_DISABLE_PROXY=0

# Optional providers for the five-generator comparison.
RAG_EVAL_MODEL2=gemini-3.8-flash
RAG_EVAL_MODEL3=deepseek-v4-flash
RAG_EVAL_MODEL4=gpt-5.4-mini
RAG_EVAL_MODEL6=qwen3.5-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
QWEN_API_KEY=
QWEN_BASE_URL=

# Large source-native data can live outside this checkout.
# EVIDENCEMEETSRAG_LINKEDOMICS_ROOT=/path/to/LinkedOmics
# EVIDENCEMEETSRAG_DEPMAP_ROOT=/path/to/DepMap
# DENSE_RAG_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DENSE_RAG_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# The default model uses this fixed revision; see configs/dense_encoder.json.
