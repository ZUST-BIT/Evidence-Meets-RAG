{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kg/schema/multisource_evidence_kg_schema_v1.json",
  "title": "Unified multi-source evidence knowledge graph schema",
  "description": "Schema for a unified evidence-centric biomedical knowledge graph spanning PubMed literature, LinkedOmics TCGA cohorts, and DepMap functional genomics. The design preserves compatibility with the existing pubmed-evidence-kg record structure while adding normalized provenance, cohort context, embedded proposition semantics, evidence payload, uncertainty, and graph relation slots needed for cross-source reasoning without requiring standalone proposition nodes.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_metadata",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "graph_metadata": {
      "type": "object",
      "required": [
        "graph_id",
        "graph_name",
        "created_by",
        "created_at",
        "source_families",
        "disease_scope"
      ],
      "properties": {
        "graph_id": {
          "type": "string"
        },
        "graph_name": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceFamily"
          },
          "minItems": 1
        },
        "disease_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "build_parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/evidenceNode"
          },
          {
            "$ref": "#/$defs/entityNode"
          },
          {
            "$ref": "#/$defs/cohortNode"
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceFamily": {
      "type": "string",
      "enum": [
        "pubmed_literature",
        "tcga_linkedomics",
        "depmap",
        "integrated"
      ]
    },
    "dbIdentifier": {
      "type": "object",
      "required": [
        "db_source",
        "dbid"
      ],
      "properties": {
        "db_source": {
          "type": "string"
        },
        "dbid": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    },
    "entityMention": {
      "type": "object",
      "required": [
        "name",
        "entity_type"
      ],
      "properties": {
