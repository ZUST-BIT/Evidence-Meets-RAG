          "maximum": 1.0
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "subject",
            "object",
            "outcome",
            "context",
            "intervention",
            "comparator",
            "supporting_entity",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "sourceLegacy": {
