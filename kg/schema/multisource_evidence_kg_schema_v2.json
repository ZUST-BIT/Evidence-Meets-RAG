            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "statistics": {
          "$ref": "#/$defs/statistics"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "citation": {
          "oneOf": [
            {
              "$ref": "#/$defs/citation"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_context": {
          "type": "object",
          "additionalProperties": true
        },
        "reviewer_comments": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
