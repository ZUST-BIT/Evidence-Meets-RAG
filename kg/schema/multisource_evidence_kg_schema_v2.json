            "string",
            "null"
          ]
        },
        "analysis_pipeline": {
          "type": "string"
        },
        "extractor_name": {
          "type": "string"
        },
        "extractor_version": {
          "type": [
            "string",
            "integer"
          ]
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "study_design": {
          "type": "string"
        },
        "clinical_stage": {
          "type": "string"
        },
        "licence": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_primary_observation": {
          "type": "boolean"
        },
        "source_priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "evidenceNode": {
      "type": "object",
      "required": [
        "node_type",
        "id",
