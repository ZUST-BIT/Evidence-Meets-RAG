          "type": "string"
        },
        "source_family": {
          "$ref": "#/$defs/sourceFamily"
        },
        "disease": {
          "type": "string"
        },
        "cohort_id": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/entityRef"
        },
        "object": {
          "oneOf": [
            {
              "$ref": "#/$defs/entityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/entityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "predicate": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "polarity": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "hypothesis_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "support": {
          "$ref": "#/$defs/supportFlags"
        },
        "evidence_category": {
          "type": "string"
        },
        "feature_layer": {
