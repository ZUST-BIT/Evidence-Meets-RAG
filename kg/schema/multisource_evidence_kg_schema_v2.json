          ]
        },
        "statistical_support_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_reliability_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "sample_size_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "extraction_confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "ds_belief": {
          "type": [
            "number",
            "null"
          ]
        },
        "ds_plausibility": {
          "type": [
            "number",
            "null"
          ]
        },
        "ds_ignorance": {
          "type": [
            "number",
            "null"
          ]
        },
        "contradiction_risk": {
          "type": [
            "number",
            "null"
          ]
        },
        "data_completeness": {
          "type": [
            "number",
            "null"
          ]
        },
        "review_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "supportFlags": {
      "type": "object",
      "required": [
        "supports_target_discovery",
        "supports_mechanism_inference",
        "supports_drug_repositioning"
      ],
      "properties": {
        "supports_target_discovery": {
          "type": "boolean"
        },
        "supports_mechanism_inference": {
          "type": "boolean"
        },
        "supports_drug_repositioning": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_family",
        "source_dataset",
        "source_release",
        "source_record_id",
        "source_file",
        "analysis_pipeline",
        "extractor_name",
        "extractor_version",
        "extracted_at",
        "study_design",
        "clinical_stage",
        "is_primary_observation",
        "source_priority"
      ],
      "properties": {
        "source_family": {
          "$ref": "#/$defs/sourceFamily"
        },
        "source_dataset": {
          "type": "string"
        },
        "source_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_record_id": {
          "type": "string"
        },
