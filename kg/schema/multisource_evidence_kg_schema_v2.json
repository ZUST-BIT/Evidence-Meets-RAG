{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kg/schema/multisource_evidence_kg_schema_v2.json",
  "title": "Unified multi-source evidence knowledge graph schema (compact v2)",
  "description": "Compact schema for a unified evidence-centric biomedical knowledge graph spanning PubMed literature, LinkedOmics TCGA cohorts, and DepMap functional genomics. Evidence nodes keep only reasoning-critical fields plus source-specific context blocks, while repeated disease/entity/cohort metadata remains on dedicated cohort and entity nodes or in provenance.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_metadata",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0.0", "2.1.0"]
    },
    "graph_metadata": {
      "type": "object",
      "required": [
        "graph_id",
        "graph_name",
        "created_by",
        "created_at",
        "source_families",
        "disease_scope"
      ],
      "properties": {
        "graph_id": {
          "type": "string"
        },
        "graph_name": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceFamily"
          },
          "minItems": 1
        },
        "disease_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "build_parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/evidenceNode"
          },
          {
            "$ref": "#/$defs/entityNode"
          },
          {
            "$ref": "#/$defs/cohortNode"
          },
          {
            "$ref": "#/$defs/observationNode"
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceFamily": {
      "type": "string",
      "enum": [
        "pubmed_literature",
        "tcga_linkedomics",
        "depmap",
        "disgenet",
        "cellline_annotation",
        "integrated"
      ]
    },
    "entityType": {
      "type": "string",
      "enum": [
        "Gene",
        "Protein",
        "Disease",
        "Drug",
        "Pathway",
        "CellType",
        "CellLine",
        "Phenotype",
        "Cohort",
        "Tissue",
        "Other"
      ]
    },
    "entityRef": {
      "type": "object",
      "required": [
        "label",
        "entity_type"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/entityType"
        }
      },
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "properties": {
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "pmid": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "impact_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "jcr_quartile": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation_count": {
          "type": [
            "integer",
            "number",
            "null"
          ]
        },
        "pdf_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "sample_grouping",
        "comparison_type",
        "comparison_label"
      ],
      "properties": {
        "sample_grouping": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparison_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparison_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_a": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_b": {
          "type": [
            "string",
            "null"
          ]
        },
        "n_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "n_effective": {
          "type": [
            "integer",
            "null"
          ]
        },
        "n_group_a": {
          "type": [
            "integer",
            "null"
          ]
        },
        "n_group_b": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "required": [
        "sample_size",
        "effect_size"
      ],
      "properties": {
        "p_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "q_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "fold_change": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence_interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "effect_size": {
          "type": [
            "number",
            "null"
          ]
        },
        "hazard_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "mutation_frequency": {
          "type": [
            "number",
            "null"
          ]
        },
        "ceres_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "codependency_coefficient": {
          "type": [
            "number",
            "null"
          ]
        },
        "synergy_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "statistical_method": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
